# Nusxa oling: cp deploy/.env.example .env   (repozitoriy ildizida, docker-compose.yml yonida)
# Domen (A yozuvi server IP siga qaratilgan bo'lishi kerak).
# Domen bo'lmasa: IP dagi nuqtalarni chiziqchaga almashtirib .sslip.io qo'shing, masalan 164-92-1-2.sslip.io
DOMAIN=api.taomdosh.uz

# Uzun tasodifiy qiymatlar: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# gateway.telegram.org tokeni
TELEGRAM_GATEWAY_TOKEN=
# Sinovchilar uchun doimiy kod (vergul bilan raqamlar). Ishlab chiqarishda "*" QO'YMANG.
AUTH_TEST_PHONES=
AUTH_TEST_CODE=
