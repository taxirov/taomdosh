# --- Server ---
PORT=3000
NODE_ENV=development
# Ma'lumotlar bazasi va Redis
DATABASE_URL=postgresql://taomdosh:taomdosh@localhost:5432/taomdosh?schema=public
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Ishlab chiqarishda uzun tasodifiy qiymat qo'ying: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Telegram Gateway (tasdiqlash kodi) ---
# gateway.telegram.org dan olingan token. Bo'sh bo'lsa, kodlar faqat serverning logiga yoziladi.
TELEGRAM_GATEWAY_TOKEN=
# Test rejimi: shu raqamlar uchun kod yuborilmaydi va AUTH_TEST_CODE qabul qilinadi.
# Vergul bilan: +998901234567,+998911112233. "*" — hamma raqamlar uchun (faqat lokal ishlab chiqishda!).
AUTH_TEST_PHONES=
AUTH_TEST_CODE=111111

# --- Mahallarni qulflash ---
# Har 30 s da vaqti kelgan mahallarni qulflaydi. "off" — o'chirish (e2e testlar o'zi chaqiradi).
MEAL_LOCK_POLLER=on
